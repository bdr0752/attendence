#pragma code_page(65001)
#include "resource.h"
#include <afxres.h>
#include <commctrl.h>

IDD_MAIN DIALOGEX 0, 0, 650, 390
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "大学生考勤系统 MFC"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "大学生考勤系统", -1, 12, 10, 220, 16
    LTEXT "视图", -1, 12, 32, 25, 12
    COMBOBOX IDC_VIEW, 40, 29, 120, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_QUERYTYPE, 172, 29, 65, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_QUERY, 243, 29, 115, 16, ES_AUTOHSCROLL
    LTEXT "班级", -1, 370, 32, 25, 12
    EDITTEXT IDC_CLASS, 398, 29, 120, 16, ES_AUTOHSCROLL
    PUSHBUTTON "应用筛选", IDC_REFRESH, 537, 28, 100, 19
    LTEXT "起始月日", -1, 12, 57, 46, 12
    EDITTEXT IDC_FIRST, 62, 54, 63, 16, ES_AUTOHSCROLL
    LTEXT "结束月日", -1, 138, 57, 46, 12
    EDITTEXT IDC_LAST, 188, 54, 63, 16, ES_AUTOHSCROLL
    LTEXT "格式 MM-DD；留空为全部；日报使用起始月日", -1, 267, 57, 274, 12
    LTEXT "", IDC_COUNTS, 12, 79, 626, 14
    CONTROL "", IDC_TABLE, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 12, 100, 626, 232
    PUSHBUTTON "新增", IDC_ADD, 12, 340, 50, 21
    PUSHBUTTON "修改", IDC_EDIT, 69, 340, 50, 21
    PUSHBUTTON "删除", IDC_DELETE, 126, 340, 50, 21
    COMBOBOX IDC_SORTKEY, 187, 341, 55, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "排序", IDC_SORT, 247, 340, 44, 21
    COMBOBOX IDC_FORMAT, 303, 341, 49, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "导出", IDC_EXPORT, 357, 340, 44, 21
    PUSHBUTTON "演示数据", IDC_DEMO, 413, 340, 60, 21
    PUSHBUTTON "恢复备份", IDC_RESTORE, 481, 340, 60, 21
    PUSHBUTTON "说明", IDC_APPHELP, 549, 340, 39, 21
    PUSHBUTTON "退出", IDCANCEL, 596, 340, 42, 21
    LTEXT "人数按学号去重；各状态次数按记录统计。修改后自动保存。", -1, 12, 371, 626, 12
END

IDD_STUDENT DIALOGEX 0, 0, 280, 144
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "学生信息"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "学号", -1, 14, 18, 35, 12
    EDITTEXT IDC_ID, 60, 14, 200, 18, ES_AUTOHSCROLL
    LTEXT "姓名", -1, 14, 49, 35, 12
    EDITTEXT IDC_NAME, 60, 45, 200, 18, ES_AUTOHSCROLL
    LTEXT "班级", -1, 14, 80, 35, 12
    EDITTEXT IDC_STUDENTCLASS, 60, 76, 200, 18, ES_AUTOHSCROLL
    DEFPUSHBUTTON "保存", IDOK, 130, 111, 60, 22
    PUSHBUTTON "取消", IDCANCEL, 200, 111, 60, 22
END

IDD_RECORD DIALOGEX 0, 0, 280, 192
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "考勤登记"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "学生学号", -1, 14, 18, 46, 12
    EDITTEXT IDC_ID, 70, 14, 190, 18, ES_AUTOHSCROLL
    LTEXT "月份", -1, 14, 49, 35, 12
    EDITTEXT IDC_MONTH, 70, 45, 65, 18, ES_NUMBER
    LTEXT "日期", -1, 151, 49, 35, 12
    EDITTEXT IDC_DAY, 195, 45, 65, 18, ES_NUMBER
    LTEXT "时间段", -1, 14, 80, 46, 12
    EDITTEXT IDC_PERIOD, 70, 76, 65, 18, ES_NUMBER
    LTEXT "编号1～99", -1, 151, 80, 100, 12
    LTEXT "状态", -1, 14, 111, 35, 12
    COMBOBOX IDC_STATUS, 70, 107, 190, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "保存", IDOK, 130, 158, 60, 22
    PUSHBUTTON "取消", IDCANCEL, 200, 158, 60, 22
END
