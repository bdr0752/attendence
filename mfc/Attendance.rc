#pragma code_page(65001)
#include "resource.h"
#include <afxres.h>
#include <commctrl.h>

IDD_MAIN DIALOGEX 0, 0, 650, 360
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "大学生考勤系统"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "大学生考勤系统", IDC_TITLE, 12, 10, 400, 26
    LTEXT "学生信息与课堂考勤", IDC_SUBTITLE, 12, 36, 400, 18
    LTEXT "功能", IDC_VIEW_LABEL, 12, 56, 25, 12
    COMBOBOX IDC_VIEW, 40, 31, 120, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_QUERYTYPE, 177, 31, 65, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_QUERY, 250, 31, 200, 18, ES_AUTOHSCROLL
    PUSHBUTTON "查询 / 显示", IDC_REFRESH, 466, 30, 100, 21
    LTEXT "按学号、姓名或月日查找", IDC_HINT, 12, 74, 626, 18
    LTEXT "", IDC_COUNTS, 12, 65, 626, 14
    CONTROL "", IDC_TABLE, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 12, 86, 626, 224
    PUSHBUTTON "新增", IDC_ADD, 12, 318, 60, 21
    PUSHBUTTON "修改", IDC_EDIT, 83, 318, 60, 21
    PUSHBUTTON "删除", IDC_DELETE, 154, 318, 60, 21
    COMBOBOX IDC_SORTKEY, 230, 319, 80, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "排序依据", IDC_SORT_LABEL, 220, 318, 50, 14
    PUSHBUTTON "排序", IDC_SORT, 321, 318, 60, 21
    PUSHBUTTON "退出", IDCANCEL, 578, 318, 60, 21
    LTEXT "数据修改后自动保存；报表查看后自动保存为文本。", IDC_FOOTER, 12, 345, 626, 12
END

IDD_STUDENT DIALOGEX 0, 0, 330, 182
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "学生信息"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "学生信息", IDC_TITLE, 16, 10, 290, 25
    LTEXT "学号唯一，姓名与班级不能为空。", IDC_SUBTITLE, 16, 36, 290, 16
    LTEXT "学号", -1, 16, 61, 40, 14
    EDITTEXT IDC_ID, 70, 56, 244, 24, ES_AUTOHSCROLL
    LTEXT "姓名", -1, 16, 92, 40, 14
    EDITTEXT IDC_NAME, 70, 87, 244, 24, ES_AUTOHSCROLL
    LTEXT "班级", -1, 16, 123, 40, 14
    EDITTEXT IDC_STUDENTCLASS, 70, 118, 244, 24, ES_AUTOHSCROLL
    DEFPUSHBUTTON "保存", IDOK, 150, 153, 78, 24
    PUSHBUTTON "取消", IDCANCEL, 236, 153, 78, 24
END

IDD_RECORD DIALOGEX 0, 0, 330, 222
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "考勤登记"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "考勤登记", IDC_TITLE, 16, 10, 290, 25
    LTEXT "同一学生、月日与时间段不可重复登记。", IDC_SUBTITLE, 16, 36, 290, 16
    LTEXT "学生学号", -1, 16, 62, 48, 14
    EDITTEXT IDC_ID, 76, 57, 238, 24, ES_AUTOHSCROLL
    LTEXT "月份", -1, 16, 95, 40, 14
    EDITTEXT IDC_MONTH, 76, 90, 78, 24, ES_NUMBER
    LTEXT "日期", -1, 180, 95, 35, 14
    EDITTEXT IDC_DAY, 236, 90, 78, 24, ES_NUMBER
    LTEXT "时间段", -1, 16, 128, 48, 14
    EDITTEXT IDC_PERIOD, 76, 123, 78, 24, ES_NUMBER
    LTEXT "编号 1～99", -1, 180, 128, 128, 14
    LTEXT "考勤状态", -1, 16, 161, 48, 14
    COMBOBOX IDC_STATUS, 76, 156, 238, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "保存", IDOK, 150, 189, 78, 24
    PUSHBUTTON "取消", IDCANCEL, 236, 189, 78, 24
END
