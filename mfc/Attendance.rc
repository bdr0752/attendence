#pragma code_page(65001)
#include "resource.h"
#include <afxres.h>
#include <commctrl.h>

IDD_MAIN DIALOGEX 0, 0, 650, 360
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "大学生考勤系统 MFC"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "大学生考勤系统", -1, 12, 10, 220, 16
    LTEXT "功能", -1, 12, 34, 25, 12
    COMBOBOX IDC_VIEW, 40, 31, 120, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_QUERYTYPE, 177, 31, 65, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_QUERY, 250, 31, 200, 18, ES_AUTOHSCROLL
    PUSHBUTTON "查询 / 显示", IDC_REFRESH, 466, 30, 100, 21
    LTEXT "日期格式MM-DD", -1, 575, 34, 65, 12
    LTEXT "", IDC_COUNTS, 12, 65, 626, 14
    CONTROL "", IDC_TABLE, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 12, 86, 626, 224
    PUSHBUTTON "新增", IDC_ADD, 12, 318, 60, 21
    PUSHBUTTON "修改", IDC_EDIT, 83, 318, 60, 21
    PUSHBUTTON "删除", IDC_DELETE, 154, 318, 60, 21
    COMBOBOX IDC_SORTKEY, 230, 319, 80, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "排序", IDC_SORT, 321, 318, 60, 21
    PUSHBUTTON "退出", IDCANCEL, 578, 318, 60, 21
    LTEXT "数据修改后自动保存；五类报表查看后自动保存为文本。", -1, 12, 345, 626, 12
END

IDD_STUDENT DIALOGEX 0, 0, 280, 144
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "学生信息"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "学号", -1, 14, 18, 35, 12
    EDITTEXT IDC_ID, 60, 14, 200, 18, ES_AUTOHSCROLL
    LTEXT "姓名", -1, 14, 49, 35, 12
    EDITTEXT IDC_NAME, 60, 45, 200, 18, ES_AUTOHSCROLL
    LTEXT "班级", -1, 14, 80, 35, 12
    EDITTEXT IDC_STUDENTCLASS, 60, 76, 200, 18, ES_AUTOHSCROLL
    DEFPUSHBUTTON "保存", IDOK, 130, 111, 60, 22
    PUSHBUTTON "取消", IDCANCEL, 200, 111, 60, 22
END

IDD_RECORD DIALOGEX 0, 0, 280, 192
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "考勤登记"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "学生学号", -1, 14, 18, 46, 12
    EDITTEXT IDC_ID, 70, 14, 190, 18, ES_AUTOHSCROLL
    LTEXT "月份", -1, 14, 49, 35, 12
    EDITTEXT IDC_MONTH, 70, 45, 65, 18, ES_NUMBER
    LTEXT "日期", -1, 151, 49, 35, 12
    EDITTEXT IDC_DAY, 195, 45, 65, 18, ES_NUMBER
    LTEXT "时间段", -1, 14, 80, 46, 12
    EDITTEXT IDC_PERIOD, 70, 76, 65, 18, ES_NUMBER
    LTEXT "编号1～99", -1, 151, 80, 100, 12
    LTEXT "状态", -1, 14, 111, 35, 12
    COMBOBOX IDC_STATUS, 70, 107, 190, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "保存", IDOK, 130, 158, 60, 22
    PUSHBUTTON "取消", IDCANCEL, 200, 158, 60, 22
END
